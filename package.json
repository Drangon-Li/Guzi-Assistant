    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^38.2.0",
    "electron-vite": "^4.0.0",
    "puppeteer-core": "^25.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "overrides": {
    "axios": "^1.18.0"
  }
