  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.66.1",
    "better-sqlite3": "^12.2.0",
    "mammoth": "^1.8.0",
    "pdf-parse": "^1.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@tailwindcss/vite": "^4.1.0",
