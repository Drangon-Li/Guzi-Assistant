{
  "name": "guzi-assistant",
  "productName": "谷子助手",
  "version": "0.11.1",
  "description": "谷子助手个人事项捕获助手",
  "main": "out/main/index.js",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "test": "node test/run.mjs",
    "test:unit": "node test/run.mjs",
    "test:demo": "node test/run.mjs task-chain-demo screen-safety activity-timeline usage-sampler semantic-work-privacy history-boundary-demo history-service-demo activity-tracker-privacy",
    "test:parser": "node test/run.mjs parser",
    "pack:mac": "electron-vite build && electron-builder --mac",
    "pack:dir": "electron-vite build && electron-builder --mac --dir",
    "prepare:win": "node scripts/prepare-windows.mjs",
    "pack:win": "npm run prepare:win && electron-vite build && electron-builder --win --x64 --publish never",
    "pack:win:dir": "npm run prepare:win && electron-vite build && electron-builder --win --x64 --dir --publish never",
    "test:packaged:win": "node scripts/test-windows-package.mjs"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.66.1",
    "@supabase/supabase-js": "^2.108.2",
    "better-sqlite3": "^12.2.0",
    "katex": "^0.18.5",
    "mammoth": "^1.8.0",
    "pdf-parse": "^1.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^38.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "puppeteer-core": "^25.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "overrides": {
    "axios": "^1.18.0"
  }
}
