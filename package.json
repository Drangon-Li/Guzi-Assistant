    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "test:parser": "node test/parser-smoke.mjs",
    "test:screen": "node test/screen-smoke.mjs",
    "test:logic": "node test/logic-smoke.mjs",
    "test:ics": "node test/ics-smoke.mjs",
    "test:parse": "node test/parse-smoke.mjs",
    "test:labels": "node test/labels-smoke.mjs",
    "test:ipc": "node test/ipc-channels-smoke.mjs",
    "test:brief": "node test/daily-brief-smoke.mjs",
    "test:hints": "node test/belonging-hints-smoke.mjs",
    "test:filters": "node test/task-filters-smoke.mjs",
    "test:phash": "node test/phash-smoke.mjs",
    "test:safepath": "node test/safe-path-smoke.mjs",
    "test:ftsquery": "node test/fts-query-smoke.mjs",
    "test:chatlayout": "node test/chat-layout-smoke.mjs",
    "test:belonglearn": "node test/belonging-learn-smoke.mjs",
    "test:chpay": "node test/chpay-smoke.mjs",
    "test:unit": "node test/logic-smoke.mjs && node test/screen-smoke.mjs && node test/ics-smoke.mjs && node test/parse-smoke.mjs && node test/labels-smoke.mjs && node test/ipc-channels-smoke.mjs && node test/daily-brief-smoke.mjs && node test/belonging-hints-smoke.mjs && node test/task-filters-smoke.mjs && node test/phash-smoke.mjs && node test/safe-path-smoke.mjs && node test/fts-query-smoke.mjs && node test/chat-layout-smoke.mjs && node test/belonging-learn-smoke.mjs && node test/chpay-smoke.mjs"
