# 托管后端（数据库即后端）。客户端默认内置我方 Supabase（rtgypddrknuylecqejmp），
# 注册登录即用、无需配置；仅自建后端时用以下两项覆盖（publishable key 可公开）。
VITE_ESHELL_SUPABASE_URL=
VITE_ESHELL_SUPABASE_ANON_KEY=
# 解析走托管 parse 网关（登录即用，无需配置 key）。以下为可选 BYOK 直连回退，
# 留空即禁用；填了才用自备 OpenAI 兼容端点（Responses API）。
ESHELL_API_BASE=
ESHELL_API_KEY=
ESHELL_MODEL=
# 飞书自建应用凭证（可选，也可在设置页填写）
ESHELL_FEISHU_APP_ID=
ESHELL_FEISHU_APP_SECRET=
