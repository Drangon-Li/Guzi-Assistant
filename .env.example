# 托管后端（数据库即后端）。客户端默认内置我方 Supabase（rtgypddrknuylecqejmp），
# 注册登录即用、无需配置；仅自建后端时用以下两项覆盖（publishable key 可公开）。
VITE_GUZI_ASSISTANT_SUPABASE_URL=
VITE_GUZI_ASSISTANT_SUPABASE_ANON_KEY=
# 解析走托管 parse 网关（登录即用，无需配置 key）。以下为可选 BYOK 直连回退，
# 留空即禁用；填了才用自备 OpenAI 兼容端点（Responses API）。
# 也兼容标准 OPENAI_BASE_URL / OPENAI_API_KEY / OPENAI_MODEL 命名。
GUZI_ASSISTANT_API_BASE=
GUZI_ASSISTANT_API_KEY=
GUZI_ASSISTANT_MODEL=
# 语音纪要的转录服务（OpenAI 兼容 /v1/audio/transcriptions）。
# 也可在设置页「语音纪要」里填；设置页填的优先，这里是本地开发的回退。
GUZI_ASSISTANT_VOICE_API_BASE=
GUZI_ASSISTANT_VOICE_API_KEY=
GUZI_ASSISTANT_VOICE_MODEL=
# 飞书自建应用凭证（可选，也可在设置页填写）
GUZI_ASSISTANT_FEISHU_APP_ID=
GUZI_ASSISTANT_FEISHU_APP_SECRET=
# 旧 VITE_ESHELL_* / ESHELL_* 名称仍可作为升级兼容回退读取。
